local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerUpdateColor = ReplicatedStorage:WaitForChild("ServerUpdateColor")
local ServerChangeSkinColor = ReplicatedStorage:WaitForChild("ServerChangeSkinColor")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- Remaining parts (hats, capes, sleeves, jackets, shoes removed)
local items = {
    "Eyebrowsp","Eyebrowsp1","Eyebrowso","Eyebrowso1",
    "Propo","Prope","Props","Propp",
    "PantsThighp","PantsCalfp1","PantsThighp1","PantsCalfp",
    "PantsThigho","PantsCalfo","PantsThigho1","PantsCalfo1",
    "Righteyei","Lefteyei","Lefteyew","Righteyemh","Righteyew",
    "Lefteyemh","Lefteyeb","Righteyeb",
    "Front_Hairp","Rear_Hairp","Back_Hairo","Front_Hairo",
    "Rear_Hairo","Rear_Hairs","Front_Hairs","Back_Hairp",
    "Back_Hairs","Back_Haire",
    "Moutho",
    "Shirtp","ShirtBotp","Shirts","ShirtBots","Shirto","Shirtboto"
}

-- Toggle state
local effectEnabled = true

-- Selected colors (filled by GUI)
local selectedColors = {}

-- Fallback if nothing selected
local fallbackColors = {
    {R = 0, G = 0, B = 0},    -- Black
    {R = 1, G = 1, B = 1}     -- White
}

local function getCurrentColors()
    if #selectedColors > 0 then
        return selectedColors
    else
        return fallbackColors
    end
end

-- Instantly set everything to black when stopping
local function setAllBlack()
    local black = {R = 0, G = 0, B = 0}
    for _, partName in ipairs(items) do
        ServerUpdateColor:FireServer(partName, black)
    end
    ServerChangeSkinColor:FireServer(black)
    ServerChangeSkinColor:FireServer(black, true)
end

-- Main flashing loop (3× speed)
task.spawn(function()
    while true do
        if effectEnabled then
            local colors = getCurrentColors()
            if #colors == 0 then colors = fallbackColors end

            -- Shuffle items
            local shuffled = {}
            for _, v in ipairs(items) do table.insert(shuffled, v) end
            for i = #shuffled, 2, -1 do
                local j = math.random(i)
                shuffled[i], shuffled[j] = shuffled[j], shuffled[i]
            end

            -- Assign random color from selected ones to each part
            for _, partName in ipairs(shuffled) do
                local color = colors[math.random(#colors)]
                ServerUpdateColor:FireServer(partName, color)
            end

            -- Skin & outline also random from selected colors
            local skinColor = colors[math.random(#colors)]
            ServerChangeSkinColor:FireServer(skinColor)

            local outlineColor = colors[math.random(#colors)]
            ServerChangeSkinColor:FireServer(outlineColor, true)
        end

        task.wait(0.0667) -- ≈15 changes/sec (3× faster than original 0.2s)
    end
end)

