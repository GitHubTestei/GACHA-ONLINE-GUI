-- toggle state
local rainbowEnabled = true

-- function to set everything to black
local function setAllBlack()
    local black = {["R"] = 0, ["G"] = 0, ["B"] = 0}

    -- all outfit items
    for _, partName in ipairs(items) do
        ServerUpdateColor:FireServer(partName, black)
    end

    -- skin + outline
    ServerChangeSkinColor:FireServer(black)
    ServerChangeSkinColor:FireServer(black, true)
end

-- function for rainbow cycling
local function startRainbow(partName)
    task.spawn(function()
        local index = 1
        while true do
            if rainbowEnabled then
                local color = colors[index]
                ServerUpdateColor:FireServer(partName, color)
                index += 1
                if index > #colors then
                    index = 1
                end
            end
            task.wait(0.1)
        end
    end)
end

