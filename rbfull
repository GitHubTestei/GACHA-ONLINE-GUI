-- shuffle helper
local function shuffle(t)
    local n = #t
    for i = n, 2, -1 do
        local j = math.random(i)
        t[i], t[j] = t[j], t[i]
    end
end

-- launch everything
local all = {}
for _, v in ipairs(items) do
    table.insert(all, function() startRainbow(v) end)
end
table.insert(all, startRainbowSkin)
table.insert(all, startRainbowSkinOutline)

shuffle(all)

task.spawn(function()
    for _, fn in ipairs(all) do
        fn()
        task.wait(0.2)
    end
end)

